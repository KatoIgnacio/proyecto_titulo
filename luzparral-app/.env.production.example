APP_NAME="Luzparral Contingencias"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://parra.chillan.ubiobio.cl:2004
APP_TIMEZONE=America/Santiago

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=REEMPLAZAR_HOST_MYSQL_INSTITUCIONAL
DB_PORT=3306
DB_DATABASE=REEMPLAZAR_BASE_DE_DATOS
DB_USERNAME=REEMPLAZAR_USUARIO
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cambiar a true solamente cuando APP_URL utilice HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# La aplicación no despacha trabajos actualmente; evita requerir un worker separado.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Temporalmente registra las recuperaciones de contraseña en logs.
# Antes de uso real se debe configurar SMTP o deshabilitar esa función.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="sistema@luzparral.example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
